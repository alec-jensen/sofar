# Generate independent random values. Never commit .env.
SOFAR_ENV=production
SOFAR_ORIGIN=https://money.example.com
SOFAR_ADDR=127.0.0.1:8080
SOFAR_ENCRYPTION_KEY=
SOFAR_SETUP_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://sofar:REPLACE_ME@localhost:5432/sofar?sslmode=disable
# Only enable with a trusted TLS reverse proxy; never expose the app port publicly.
TRUST_PROXY=true
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
TZ=America/Chicago
